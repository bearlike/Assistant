    {
      "name": "project_switch_is_conversation_not_trace",
      "why": "A completed switch_project is CONVERSATION: every tool call and sub-agent after it ran in a different directory, so a reader without the row silently attributes the rest of the turn to the first project. A REFUSED switch (success=false, the shared error envelope) must produce nothing \u2014 nothing moved \u2014 and a result naming no project is unreadable and must also produce nothing. Every other tool_result stays trace-only.",
      "events": [
        {
          "type": "user",
          "ts": "t0",
          "payload": {
            "text": "fix the failing test in beacon"
          }
        },
        {
          "type": "tool_result",
          "ts": "t1",
          "payload": {
            "tool_id": "read_file",
            "success": true,
            "result": "x = 1"
          }
        },
        {
          "type": "tool_result",
          "ts": "t2",
          "payload": {
            "tool_id": "switch_project",
            "success": false,
            "result": "{'error': {'code': 'unavailable', 'message': \"Project 'ghost' points at '/srv/ghost', which does not exist on this host.\"}}"
          }
        },
        {
          "type": "tool_result",
          "ts": "t3",
          "payload": {
            "tool_id": "switch_project",
            "success": true,
            "result": "{\"project\": \"beacon\", \"name\": \"beacon\", \"kind\": \"configured\", \"cwd\": \"/srv/beacon\", \"repo\": \"git.example.com/acme/beacon\", \"branch\": null, \"description\": \"Second project\", \"previous_project\": null, \"previous_cwd\": \"/srv/alpha\", \"project_instructions_found\": true, \"bound_tools\": 42, \"skills\": 7, \"summary\": \"Switched to project 'beacon' (configured).\"}"
          }
        },
        {
          "type": "tool_result",
          "ts": "t4",
          "payload": {
            "tool_id": "switch_project",
            "success": true,
            "result": "{\"cwd\": \"/srv/nowhere\"}"
          }
        },
        {
          "type": "assistant",
          "ts": "t5",
          "payload": {
            "text": "fixed"
          }
        }
      ],
      "expected": [
        {
          "id": "user-1",
          "role": "user",
          "turnId": "turn-1",
          "content": "fix the failing test in beacon",
          "ts": "t0"
        },
        {
          "id": "project-switch-t3",
          "role": "project_switch",
          "turnId": "turn-1",
          "content": "",
          "ts": "t3"
        },
        {
          "id": "assistant-1",
          "role": "assistant",
          "turnId": "turn-1",
          "content": "fixed",
          "ts": null
        }
      ]
    },
    {
      "name": "safety_plane_disclosure_and_deny",
      "why": "Disclosure fires before the plane evaluates anything (inside the first open turn, before any tool call); a deny can land between turns exactly like a fired trigger, so both are hoisted above the open-turn gate rather than dropped.",
      "events": [
        {
          "type": "user",
          "ts": "t0",
          "payload": {
            "text": "q1"
          }
        },
        {
          "type": "safety_plane",
          "ts": "t0.5",
          "payload": {
            "phase": "disclosed",
            "documents": [
              ".mewbo/policy/house-rules.md"
            ],
            "rules": [
              {
                "name": "no-payments",
                "kind": "tool.match",
                "decision": "deny",
                "inspects": "tool ids matching mcp__payments__.*"
              }
            ],
            "inspects_tool_calls": true,
            "inspects_turns": true
          }
        },
        {
          "type": "assistant",
          "ts": "t1",
          "payload": {
            "text": "a1"
          }
        },
        {
          "type": "safety_plane",
          "ts": "t2",
          "payload": {
            "phase": "deny",
            "rule": "turn-ceiling",
            "reason": "Run exceeded its turn ceiling."
          }
        }
      ],
      "expected": [
        {
          "id": "user-1",
          "role": "user",
          "turnId": "turn-1",
          "content": "q1",
          "ts": "t0"
        },
        {
