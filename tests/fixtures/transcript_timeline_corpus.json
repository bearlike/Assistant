          "type": "user",
          "ts": "t0",
          "payload": {
            "text": "go"
          }
        },
        {
          "type": "context_compacted",
          "ts": "t1",
          "payload": {
            "depth": 0,
            "mode": "reactive"
          }
        },
        {
          "type": "assistant",
          "ts": "t2",
          "payload": {
