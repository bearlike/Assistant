      "expected": [
        {
          "id": "user-1",
          "role": "user",
          "turnId": "turn-1",
          "content": "go",
          "ts": "t0"
        },
        {
          "id": "plan-1",
          "role": "plan",
          "turnId": "turn-1",
          "content": "",
          "ts": null
        },
        {
          "id": "todos-turn-1",
          "role": "todos",
          "turnId": "turn-1",
          "content": "",
          "ts": "t2"
        },
        {
          "id": "widget-t3",
          "role": "widget",
          "turnId": "turn-1",
          "content": "",
          "ts": "t3"
        },
        {
          "id": "question-c1",
          "role": "question",
          "turnId": "turn-1",
          "content": "",
          "ts": "t4"
        },
        {
          "id": "assistant-1",
          "role": "assistant",
          "turnId": "turn-1",
          "content": "done",
          "ts": null
        }
      ]
    },
    {
      "name": "reactive_compaction_renders_inside_the_open_turn",
