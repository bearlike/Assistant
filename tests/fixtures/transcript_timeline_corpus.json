          "type": "user",
          "ts": "t0",
          "payload": {
            "text": "go"
          }
        },
        {
          "type": "plan_proposed",
          "ts": "t1",
          "payload": {
            "revision": 1,
            "content": "# Plan",
            "summary": "do it"
          }
        },
        {
          "type": "todos",
          "ts": "t2",
          "payload": {
            "items": [
              {
                "label": "step one",
                "status": "pending"
              }
            ]
          }
        },
        {
          "type": "widget_ready",
          "ts": "t3",
          "payload": {
            "widget_id": "w1",
            "kind": "chart"
          }
        },
        {
          "type": "user_question",
          "ts": "t4",
          "payload": {
            "call_id": "c1",
            "call_token": "secret-token",
            "questions": []
          }
        },
        {
          "type": "user_question_answered",
          "ts": "t5",
          "payload": {
            "call_id": "c1",
            "outcome": "answered",
            "answers": []
          }
        },
        {
          "type": "assistant",
          "ts": "t6",
          "payload": {
            "text": "done"
