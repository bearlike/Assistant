        },
        {
          "id": "compaction-t1",
          "role": "compaction",
          "turnId": "turn-1",
          "content": "",
          "ts": "t1"
        },
        {
          "id": "assistant-1",
          "role": "assistant",
          "turnId": "turn-1",
          "content": "ok",
          "ts": null
        }
