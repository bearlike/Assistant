    {
      "name": "generative_ui_upserts_on_ui_id",
      "why": "A model-authored UI panel folds inside an open turn like a widget, but unlike a widget it UPSERTS: ui_id is the wire's declared replace key, so a run refining a panel it already showed replaces that row in place and the row keeps the ts of its first appearance. A second, distinct ui_id gets its own row. A payload carrying no ui_id has nothing to key on and is dropped rather than given a synthetic id.",
      "events": [
        {
          "type": "user",
          "ts": "t0",
          "payload": {
            "text": "how's the build"
          }
        },
        {
          "type": "generative_ui",
          "ts": "t1",
          "payload": {
            "ui_id": "gui-0123abcd",
            "session_id": "s1",
            "spec": {
              "root": [
                {
                  "component": "Divider",
                  "props": {}
                }
              ]
            },
            "alt_text": "first",
            "summary": "CI status"
          }
        },
        {
          "type": "generative_ui",
          "ts": "t2",
          "payload": {
            "ui_id": "gui-0123abcd",
            "session_id": "s1",
            "spec": {
              "root": [
                {
                  "component": "Divider",
                  "props": {}
                }
              ]
            },
            "alt_text": "second",
            "summary": "CI status"
          }
        },
        {
          "type": "generative_ui",
          "ts": "t3",
          "payload": {
            "ui_id": "gui-99887766",
            "session_id": "s1",
            "spec": {
              "root": [
                {
                  "component": "Divider",
                  "props": {}
                }
              ]
            },
            "alt_text": "other",
            "summary": "coverage"
          }
        },
        {
          "type": "generative_ui",
          "ts": "t4",
          "payload": {
            "alt_text": "unkeyed"
          }
        },
        {
          "type": "assistant",
          "ts": "t5",
          "payload": {
            "text": "green"
          }
        }
      ],
      "expected": [
        {
          "id": "user-1",
          "role": "user",
          "turnId": "turn-1",
          "content": "how's the build",
          "ts": "t0"
        },
        {
          "id": "genui-gui-0123abcd",
          "role": "generative_ui",
          "turnId": "turn-1",
          "content": "",
          "ts": "t1"
        },
        {
          "id": "genui-gui-99887766",
          "role": "generative_ui",
          "turnId": "turn-1",
          "content": "",
          "ts": "t3"
        },
        {
          "id": "assistant-1",
          "role": "assistant",
          "turnId": "turn-1",
          "content": "green",
          "ts": null
        }
      ]
    },
    {
      "name": "generative_ui_model_authored_readable_id_upserts",
      "why": "ui_id is model-authorable and READABLE, not gui-hex: both assemblers key the upsert on the id as an opaque string, so a readable id ('team-directory') replaces in place exactly like a generated one. Pinned here because the server relaxed its id pattern and neither assembler may start second-guessing the shape.",
      "events": [
        {
          "type": "user",
          "ts": "t0",
          "payload": {
            "text": "show the team"
