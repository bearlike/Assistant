<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Haptic map (spec §6.13) — without this, Vibrator.vibrate silently no-ops. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- device_set_alarm/device_set_timer (Gitea #179): lets ACTION_SET_ALARM/ACTION_SET_TIMER
         reach the clock app without an OEM confirmation prompt. Normal protection level, granted
         at install. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- device_wake (Gitea #179): AlarmManager.setAlarmClock (WakeDeviceHandler) is lint-flagged
         (MissingPermission) without this declared, even though setAlarmClock's user-facing-alarm
         semantics exempt it from the runtime "Alarms & reminders" special-access restriction other
         exact-alarm APIs need. Auto-granted at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- device_read_latest_sms / device_send_sms (Gitea #179 Phase 4): dangerous-protection-level,
         requested at runtime via Settings' "SMS access" row (ui/settings) - no other gate. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- READ_SMS/SEND_SMS otherwise imply telephony hardware is REQUIRED (Play Store default,
         lint's PermissionImpliesUnsupportedChromeOsHardware) - required="false" so a phone-less
         install (tablet/ChromeOS) isn't blocked; the SMS tools are just permission-gated out of
         the catalog there like anywhere else the grant is missing. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".AuraApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Aura"
        android:supportsRtl="true">

        <!-- windowSoftInputMode: no Compose code anywhere requests focus (verified) - the IME
             opening on cold launch with no tap is the platform default for an unspecified `state`
             on a window with a focusable text field. `stateHidden` keeps it closed until the user
             taps the composer; `adjustResize` is what lets the composer avoid the IME once it IS
             open (Scaffold's default contentWindowInsets = safeDrawing, which includes `ime`, only
             actually resizes the window if the mode says so). -->
        <!-- launchMode="singleTask" (Gitea #178 W2): the assist overlay's handoff
             (AuraSession.handleHandoff) starts this Activity from a VoiceInteractionSession
             context on every invocation - without singleTask, a warm handoff while the app is
             already running would stack a duplicate instance instead of redelivering via
             onNewIntent(). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Aura"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Assistant-role invocation (§5.1, §5.3): long-lived marker service + session factory.
             Both require BIND_VOICE_INTERACTION so only the system can bind them. -->
        <service
            android:name=".voice.AuraVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".voice.AuraSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- device_wake (Gitea #179): fired only by our own AlarmManager.setAlarmClock PendingIntent
             (WakeDeviceHandler) - never exported, no external caller can trigger it. -->
        <receiver
            android:name=".data.device.WakeAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
