{
  "name": "mewbo-console",
  "version": "0.0.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-pyodide": "node scripts/fetch-pyodide.mjs",
    "postinstall": "node scripts/fetch-pyodide.mjs || true",
    "build": "node scripts/fetch-pyodide.mjs && vite build && vite build --config vite.widget-host.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:ci": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config=playwright.demo.config.ts",
    "deploy": "npm run build && docker compose -f ../../docker-compose.yml restart console"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@codemirror/autocomplete": "^6.20.3",
