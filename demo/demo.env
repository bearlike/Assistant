# demo.env — env-file for `docker compose -f demo/docker-compose.demo.yml`.
#
# Committed on purpose: the demo stack is fully isolated (own bridge network,
# no LLM proxy reachable, ephemeral Mongo) and every value below is a
# deterministic fixture, never a real credential. A later "live mode" phase
# that talks to a real LLM would need its own untracked secrets file — this
# one stays replay-only.

# Fixed T0 the seeder anchors every seeded timestamp to (as offsets from this
# instant) and the Playwright specs anchor their relative-time assertions to
# ("3 minutes ago" must render identically on every run). Freezing it is what
# makes the captured screenshots/recordings byte-for-byte reproducible across
# machines and days — see project memory on demo-as-code RelativeTime hazard.
DEMO_T0=2026-07-14T09:30:00Z

# Break-glass API token for the demo api service. Not a secret (isolated
# bridge network only) — matches api.master_token behavior: MASTER_API_TOKEN
# env overrides configs/app.json.
DEMO_API_KEY=mewbo-demo-master-token

# Mongo database name used by both the api and seed services.
DEMO_MONGODB_DATABASE=mewbo_demo

# Loopback debug port for the console, published as 127.0.0.1:<port>:3001 so
# a human can eyeball the seeded UI without going through the shots service.
DEMO_CONSOLE_PORT=3210
