# syntax=docker/dockerfile:1

# Dockerfile.mcp — Mewbo MCP server
# Mirrors Dockerfile.api: same base, same workspace copy, different package
# installed and a simple CMD instead of the gunicorn entrypoint.
# No default on purpose — see Dockerfile.api. Every caller passes it, and a
# default would silently float to :latest when one did not.
ARG BASE_IMAGE
FROM $BASE_IMAGE

ARG VERSION="0.0.14"

LABEL org.opencontainers.image.title="Mewbo MCP" \
      org.opencontainers.image.description="Standalone MCP server exposing Mewbo to external agents" \
      org.opencontainers.image.source="https://github.com/bearlike/Assistant" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.vendor="Krishnakanth Alagiri" \
      org.opencontainers.image.licenses="MIT"

USER root
WORKDIR /app

# 1. Copy only dependency metadata first (layer caching — survives source changes)
# Workspace discovery needs every member/source manifest, even for a --package
# install that never builds the others.
# README.md because packages/mewbo_core sets `readme = "../../README.md"` and
# hatchling reads it when building the package; the base image ships no copy of
# the repo for it to fall back on.
COPY pyproject.toml uv.lock README.md ./
COPY packages/mewbo_core/pyproject.toml packages/mewbo_core/pyproject.toml
COPY packages/mewbo_tools/pyproject.toml packages/mewbo_tools/pyproject.toml
COPY packages/mewbo_graph/pyproject.toml packages/mewbo_graph/pyproject.toml
COPY apps/mewbo_api/pyproject.toml apps/mewbo_api/pyproject.toml
COPY apps/mewbo_cli/pyproject.toml apps/mewbo_cli/pyproject.toml
COPY apps/mewbo_mcp/pyproject.toml apps/mewbo_mcp/pyproject.toml
COPY apps/mewbo_ha_conversation/pyproject.toml apps/mewbo_ha_conversation/pyproject.toml

# 2. Copy source
COPY packages/ packages/
COPY apps/mewbo_mcp/ apps/mewbo_mcp/
COPY configs/ configs/

# 3. Install the locked closure for the mcp app — standard uv container flow
# (never re-resolve from pyproject ranges at build time; see Dockerfile.api).
RUN if ! command -v uv >/dev/null 2>&1; then pip install --no-cache-dir uv; fi
ENV UV_LINK_MODE=copy
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package mewbo-mcp
ENV PATH="/app/.venv/bin:$PATH"

# 4. Entrypoint ONLY — the SAME file Dockerfile.api uses, and as there, no
# init.d script is baked; docker-compose.yml mounts them at runtime (see
# Dockerfile.api for why). Without an entrypoint this image starts with none of
# the runtime setup the api gets: no internal-CA trust, no git credentials, no
# forge CLIs.
COPY docker/entrypoint.sh /app/docker/entrypoint.sh
RUN chmod +x /app/docker/entrypoint.sh

# Runtime toolbox for gh/tea (see Dockerfile.api for the build-vs-runtime rule).
RUN mkdir -p /opt/mewbo-tools/bin && chown -R 1000:1000 /opt/mewbo-tools
ENV PATH="/opt/mewbo-tools/bin:$PATH"

ENV MEWBO_MASTER_API_TOKEN='msk-strong-password' \
    MEWBO_MCP_HOST='127.0.0.1' \
    MEWBO_MCP_PORT='5127' \
    MEWBO_API_URL='http://localhost:5125'

# Shorter than the api's list — this image mounts none of the wiki/plan/IDE
# scratch volumes, so naming them here would only warn about absent paths.
ENV INIT_CHOWN_DIRS="/app/data /opt/mewbo-tools"

USER mewbo
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["mewbo-mcp"]
