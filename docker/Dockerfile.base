# syntax=docker/dockerfile:1

# Dockerfile.base — Dev-equipped agent runtime for Mewbo
#
# trixie (Debian 13, glibc 2.41) rather than bookworm (Debian 12, glibc 2.36).
# The floor is set by prebuilt release binaries the runtime fetches, not by
# anything Python needs: current Rust-built CLIs import pidfd_spawnp/pidfd_getpid
# and so record a GLIBC_2.39 requirement, which bookworm cannot satisfy — the
# binary installs and then dies on first use. Derived images must not hardcode
# the codename; read VERSION_CODENAME from /etc/os-release (Dockerfile.api's
# docker-ce apt source is the one place that needs it).
FROM python:3.11-trixie

# Keep in lockstep with the version in pyproject.toml (and every workspace
# member, apps/mewbo_console/package.json, and Aura's versionName) — they are all
# one product version. CI overrides this from the release branch, so a stale
# default only ever surfaced on local and compose builds, mislabelling the image
# and, here, exporting a wrong ENV VERSION at runtime.
ARG VERSION="0.0.14"
ARG USERNAME=mewbo
ARG USER_UID=1000
ARG USER_GID=$USER_UID

LABEL org.opencontainers.image.title="Mewbo Base" \
      org.opencontainers.image.description="Dev-equipped agent runtime for the Mewbo assistant" \
      org.opencontainers.image.source="https://github.com/bearlike/Assistant" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.vendor="Krishnakanth Alagiri" \
      org.opencontainers.image.licenses="MIT"

# ---------- System packages ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl wget git zsh sudo \
        jq ripgrep fd-find less vim \
        openssh-client ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# ---------- Non-root user with sudo ----------
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /usr/bin/zsh $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# ---------- Oh My Zsh ----------
USER $USERNAME
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
USER root

# ---------- nvm + Node.js LTS ----------
ENV NVM_DIR=/home/$USERNAME/.nvm
RUN mkdir -p $NVM_DIR && chown $USERNAME:$USERNAME $NVM_DIR
USER $USERNAME
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
    && . "$NVM_DIR/nvm.sh" && nvm install --lts
USER root
# Expose node/npm/npx on the system PATH via a stable symlink so non-login
# processes (gunicorn, LSP servers, npx) see the nvm-installed runtime
# without having to source nvm.sh. `npm install -g` targets the nvm prefix,
# so new global binaries land in /opt/node/bin automatically.
RUN ln -sfn "$(ls -d $NVM_DIR/versions/node/*/ | head -1 | sed 's:/$::')" /opt/node
ENV PATH=/opt/node/bin:$PATH

# Playwright CLI + Chromium deliberately do NOT live here — they are a 2.08 GB
# layer, by far the largest in this image, and only the api runtime ever drives a
# browser. Installing them in the shared base charged that cost to mcp as well,
# which has no browser code path at all. They now sit in Dockerfile.api.

# ---------- Python: uv + Mewbo core packages ----------
RUN pip install --no-cache-dir uv

WORKDIR /app

# mewbo_core + mewbo_tools are the shared libraries every runtime builds on, so
# they install here. What does NOT belong is the rest of the repo: this used to
# be `COPY . /app`, which dragged Aura's Android tree, the console's sources and
# assets, and the rendered docs site — ~3.5 GB — into this image and therefore
# into every image built FROM it.
#
# So copy the two packages plus the manifests resolution needs, and nothing
# else. packages/* are uv WORKSPACE members, so uv reads the workspace root and
# EVERY member manifest (including demo/seeder) even to install just these two;
# a missing member manifest fails the resolve. Apps contribute manifests only,
# never sources — they bring their own in Dockerfile.api / Dockerfile.mcp.
#
# README.md is not documentation here — packages/mewbo_core declares
# `readme = "../../README.md"`, so hatchling reads the ROOT file to build the
# package and the install fails without it.
COPY pyproject.toml uv.lock README.md ./
COPY packages/ packages/
COPY apps/mewbo_api/pyproject.toml apps/mewbo_api/pyproject.toml
COPY apps/mewbo_cli/pyproject.toml apps/mewbo_cli/pyproject.toml
COPY apps/mewbo_mcp/pyproject.toml apps/mewbo_mcp/pyproject.toml
COPY apps/mewbo_ha_conversation/pyproject.toml apps/mewbo_ha_conversation/pyproject.toml
COPY demo/seeder/pyproject.toml demo/seeder/pyproject.toml
COPY configs/ configs/

RUN uv pip install --system \
        -e packages/mewbo_core \
        -e packages/mewbo_tools \
    && rm -rf /root/.cache/uv

# ---------- Runtime defaults ----------
ENV CACHE_DIR='/tmp/mewbo_cache' \
    DEFAULT_MODEL='gpt-5.2' \
    LOG_LEVEL=DEBUG \
    ENVMODE=dev \
    VERSION=${VERSION} \
    COLOREDLOGS_FIELD_STYLES='asctime=color=240;name=45,inverse' \
    COLOREDLOGS_LEVEL_STYLES='info=220;spam=22;debug=34;verbose=34;notice=220;warning=202;success=118,bold;error=124;critical=background=red' \
    COLOREDLOGS_LOG_FORMAT='%(asctime)s [%(name)s] %(levelname)s %(message)s'

USER $USERNAME
