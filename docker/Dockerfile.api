# syntax=docker/dockerfile:1

# Dockerfile.api — Mewbo API with Gunicorn
# Supplied by every caller — docker-compose.yml, demo/docker-compose.demo.yml,
# and docker-buildx.yml, which pins the base to the VERSION it just built rather
# than a floating tag. Deliberately has NO default: a default would silently
# resolve to :latest whenever a caller forgot it, which is how a release build
# ends up pairing a new api with a stale base. Unset fails the build outright.
ARG BASE_IMAGE
FROM $BASE_IMAGE

# In lockstep with pyproject.toml and the other images — see Dockerfile.base.
ARG VERSION="0.0.14"

LABEL org.opencontainers.image.title="Mewbo API" \
      org.opencontainers.image.description="REST API for the Mewbo task-agent assistant" \
      org.opencontainers.image.source="https://github.com/bearlike/Assistant" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.vendor="Krishnakanth Alagiri" \
      org.opencontainers.image.licenses="MIT"

USER root
WORKDIR /app

# This image deliberately holds no Docker CLI and no socket access. The Web
# IDE feature's sibling-container management moved to a dedicated broker
# service (docker/Dockerfile.ide) that is the ONLY thing in the stack holding
# /var/run/docker.sock — this image talks to it over HTTP instead. An agent's
# arbitrary shell tool runs in this same container, so co-locating daemon
# access here would let any shell command reach the whole host as root via
# `docker run -v /:/host`; splitting the two is what removes that path.
#
# 1. Copy only dependency metadata first (layer caching — survives source changes)
# ---------- Playwright CLI + full Chromium ----------
# @playwright/cli (binary: ``playwright-cli``) — agent-oriented browser
# automation, surfaced via the ``playwright-cli`` skill. Lives HERE and not in
# Dockerfile.base: it is a 2.08 GB layer and the api is the only runtime that
# drives a browser, so keeping it in the shared base charged the whole cost to
# mcp too. Node comes from the base (/opt/node on PATH).
#
# We install the *full* Chromium build (the default browser) so sites render with
# full fidelity — JavaScript execution, web fonts, the real Chrome engine in
# new-headless mode. ``--with-deps`` pulls the Debian libraries Chromium needs;
# it shells out to ``apt-get``, so the package lists MUST be refreshed first in
# this same layer. The version is PINNED: ``@latest`` drifted to 0.1.14, whose
# negation-flag parser rejects ``--no-shell`` ("Unknown option: --shell") and
# broke the image build — so we pin and drop ``--no-shell`` (the headless shell
# ships alongside full Chromium; a few extra MB, but a deterministic build).
# Browsers land in a world-readable system path so the non-root runtime user
# (mewbo, UID 1000) can launch them.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update \
    && npm install -g @playwright/cli@0.1.14 \
    && playwright-cli install-browser --with-deps \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# README.md because packages/mewbo_core sets `readme = "../../README.md"` and
# hatchling reads it when building the package; the base image ships no copy of
# the repo for it to fall back on.
COPY pyproject.toml uv.lock README.md ./
COPY packages/mewbo_core/pyproject.toml packages/mewbo_core/pyproject.toml
COPY packages/mewbo_tools/pyproject.toml packages/mewbo_tools/pyproject.toml
COPY packages/mewbo_graph/pyproject.toml packages/mewbo_graph/pyproject.toml
COPY apps/mewbo_api/pyproject.toml apps/mewbo_api/pyproject.toml
# Workspace discovery needs every member/source manifest present, even for a
# --package install that never builds them.
COPY apps/mewbo_cli/pyproject.toml apps/mewbo_cli/pyproject.toml
COPY apps/mewbo_mcp/pyproject.toml apps/mewbo_mcp/pyproject.toml
COPY apps/mewbo_ha_conversation/pyproject.toml apps/mewbo_ha_conversation/pyproject.toml

# 2. Copy source
COPY packages/ packages/
COPY apps/mewbo_api/ apps/mewbo_api/
COPY configs/ configs/

# 3. Entrypoint ONLY — the init.d scripts are deliberately NOT baked.
#
# Runtime init belongs to the container, not the image. docker-compose.yml
# mounts docker/init.d read-only and the entrypoint SOURCES what it finds at
# start, so a script can be added, edited, or pinned to a new tool version with
# a restart instead of a rebuild — the same reason `gh`/`tea`/`models` land in a
# volume rather than a layer. Baking the scripts would freeze runtime setup into
# a published artifact.
#
# It also removes a leak vector outright. That directory is gitignored apart
# from the tracked few, so any `COPY` of it risks sweeping a developer's
# local-only script — one naming an internal host — into a ghcr.io image.
# Copying nothing cannot leak, so no allowlist has to be maintained here.
#
# The entrypoint treats a missing directory as "no init", so an image run with
# no mount at all still starts; it just performs none of the setup.
COPY docker/entrypoint.sh /app/docker/entrypoint.sh
RUN chmod +x /app/docker/entrypoint.sh

# 4. Install the locked dependency closure — the STANDARD uv container flow.
# `uv sync --frozen --package mewbo-api` installs exactly what uv.lock pins
# for the api app (never re-resolving from pyproject ranges — litellm 1.92.0
# walked into the image that way once and broke every tool-bearing
# LLM call). gunicorn comes via mewbo-api's own dependencies; the wiki extra
# (mewbo-graph[treesitter,retrieval]) rides the same lock when WIKI_EXTRAS=1.
# UV_LINK_MODE=copy: the wheel cache is a build-time mount, so the venv must
# not hardlink into it.
ARG WIKI_EXTRAS=0
# SPEECH_EXTRAS defaults ON: the speech routes are useless without the library,
# and unlike the wiki stack it pulls no heavy native deps — litellm and httpx
# are already in the api's own dependency closure, so the extra costs the image
# nothing. Set to 0 for a deployment that deliberately serves no speech; the
# namespace then never mounts and /api/speech answers 404.
ARG SPEECH_EXTRAS=1
RUN if ! command -v uv >/dev/null 2>&1; then pip install --no-cache-dir uv; fi
ENV UV_LINK_MODE=copy
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package mewbo-api \
        $( [ "$WIKI_EXTRAS" = "1" ] && printf -- '--extra wiki' ) \
        $( [ "$SPEECH_EXTRAS" = "1" ] && printf -- '--extra speech' )
ENV PATH="/app/.venv/bin:$PATH"

# SCIP symbol indexers (Python precise symbol resolution) — only baked in when
# SCIP_EXTRAS=1, mirroring the WIKI_EXTRAS toggle above. The wiki code-graph
# indexer shells out to two pinned binaries at index time:
#   - scip-python : Sourcegraph's Pyright-backed Node CLI (npm global)
#   - scip        : the SCIP companion Go CLI (print/convert/snapshot)
# Node is ALREADY on PATH from the base image (nvm LTS → /opt/node/bin), so
# `npm install -g` lands the `scip-python` bin beside it and the UID-1000
# runtime user can invoke it — same provisioning shape as the base's
# playwright-cli. The `scip` Go binary is fetched from the pinned GitHub release
# and dropped on PATH at /usr/local/bin. Defaults OFF so a base API build pays
# ~55 MB nothing for it; the compose api service flips SCIP_EXTRAS to "1"
# (alongside WIKI_EXTRAS) once Python graph indexing is wired on. Versions are
# pinned — scip-python 0.6.x and scip v0.8.x are the matched pair.
ARG SCIP_EXTRAS=0
ARG SCIP_PYTHON_VERSION=0.6.6
ARG SCIP_CLI_VERSION=v0.8.1
RUN if [ "$SCIP_EXTRAS" = "1" ]; then \
        set -eux; \
        npm install -g "@sourcegraph/scip-python@${SCIP_PYTHON_VERSION}"; \
        rm -rf /root/.npm; \
        arch="$(dpkg --print-architecture)"; \
        case "$arch" in \
            amd64) scip_arch=amd64 ;; \
            arm64) scip_arch=arm64 ;; \
            *) echo "unsupported arch for scip CLI: $arch" >&2; exit 1 ;; \
        esac; \
        curl -fsSL \
            "https://github.com/sourcegraph/scip/releases/download/${SCIP_CLI_VERSION}/scip-linux-${scip_arch}.tar.gz" \
            -o /tmp/scip.tar.gz; \
        tar -xzf /tmp/scip.tar.gz -C /usr/local/bin scip; \
        chmod +x /usr/local/bin/scip; \
        rm -f /tmp/scip.tar.gz; \
        scip-python --version; \
        scip --version; \
    fi

# Pin the tree-sitter parser cache to a fixed, shared path so the build (root)
# and the runtime (uid 1000) resolve the SAME directory —
# tree_sitter_language_pack honours XDG_CACHE_HOME. Without this, a build-time
# pre-warm under /root/.cache would be invisible to the runtime user's
# ~/.cache and re-downloaded (over the network) on the first real index.
ENV XDG_CACHE_HOME=/opt/mewbo-cache

# Pre-warm the tree-sitter grammar cache at BUILD time. get_language() fetches
# a per-language parser over the network on first use and caches it (verified
# empirically — the language-pack wheel does NOT bundle grammars, despite an
# earlier assumption); baking the cache into the image removes that runtime
# network dependency entirely (a transient blip mid-parse would otherwise
# abort a live indexing run). Uses mewbo_graph.wiki.prefetch (the single
# source of truth for the supported language list). Guarded on WIKI_EXTRAS
# like the install step above — mewbo_graph itself isn't installed at all
# when WIKI_EXTRAS=0, so the module's own "extra absent" skip can't fire.
RUN if [ "$WIKI_EXTRAS" = "1" ]; then \
        mkdir -p /opt/mewbo-cache && \
        python -m mewbo_graph.wiki.prefetch && \
        chown -R 1000:1000 /opt/mewbo-cache; \
    fi

# Pre-create plan-mode scratch directory with correct ownership.
# Named volumes copy permissions from the image on first mount, so
# ``plans-data:/tmp/mewbo/plans`` inherits mewbo ownership
# instead of root:root. The entrypoint also fixes ownership at
# runtime for volumes that already exist (see entrypoint.sh).
RUN mkdir -p /tmp/mewbo/plans /tmp/mewbo/wiki/clones /tmp/mewbo/apps && chown -R 1000:1000 /tmp/mewbo

# Runtime toolbox — where init.d/12-agent-clis.sh lands gh and tea. Backed by
# the `mewbo-tools` named volume, so the download happens once ever rather than
# once per container start. Pre-created with uid 1000 for the same reason
# /tmp/mewbo is above: a named volume copies permissions from the image on
# first mount, so this is what keeps the volume writable without a chown.
RUN mkdir -p /opt/mewbo-tools/bin && chown -R 1000:1000 /opt/mewbo-tools
ENV PATH="/opt/mewbo-tools/bin:$PATH"

ENV MEWBO_MASTER_API_TOKEN='msk-strong-password' \
    MEWBO_API_PORT=5125 \
    CLAUDE_PLUGIN_ROOT=''

# Writable paths the shared entrypoint repairs before init.d runs (api-only
# volumes; the mcp image sets its own shorter list).
ENV INIT_CHOWN_DIRS="/tmp/mewbo /tmp/mewbo/plans /tmp/mewbo/wiki /tmp/mewbo/wiki/clones /tmp/mewbo/apps /app/data /opt/mewbo-tools"

# entrypoint.sh runs docker/init.d/*.sh, then execs this CMD.
# Single worker (RunRegistry is in-memory), 5-min timeout.
# --threads is INERT on the default sync worker (one request per worker
# process); the gthread worker is what actually serves them, which is what
# keeps a cold synchronous freshness/clone check on one request from blocking
# the whole single-worker API.
#
# --threads is the API's TOTAL concurrency, process-wide: one worker means the
# thread count IS the request ceiling for every caller at once. It has to be
# generous because long-lived requests hold a thread for their whole life rather
# than for the work they do — the SSE session stream blocks on its subscription
# queue for as long as the run lasts, and a listing holds one for the duration
# of its store reads. At 8 threads, eight concurrent streams took the entire API
# to zero spare capacity and unrelated endpoints stalled for seconds; the
# starvation was global, so it read as "the server is down" rather than as a
# stream limit. These threads block on a queue or a socket and release the GIL
# while waiting, so the cost of raising the count is roughly stack memory, not
# CPU contention.
#
# This raises the ceiling; it does not remove it. Removing it means moving the
# event bus out of process so more than one worker is possible, which the
# in-memory RunRegistry above currently forbids.
#
# sh -c (not exec-form) so ${MEWBO_API_PORT} still expands — exec-form CMD would ship
# the literal string. The inner `exec` keeps gunicorn as PID 1 so it still
# receives SIGTERM for a graceful shutdown.
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["sh", "-c", "exec gunicorn \
    --bind 0.0.0.0:${MEWBO_API_PORT:-5125} \
    --workers 1 \
    --worker-class gthread \
    --threads ${API_THREADS:-48} \
    --timeout 300 \
    --graceful-timeout 30 \
    --access-logfile - \
    mewbo_api.backend:app"]
